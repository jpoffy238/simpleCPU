# Local JVM/Maven installs (copied in so Claude Code can run mvn directly
# with a full path, rather than relying on the user's own shell) - not
# portable (their Debian-style /etc symlinks get fixed up to real file
# copies locally after copying), so these stay out of version control.
/jvm/
/maven/

# SDCC's build output for modules/cpu/z80/src/main/c - scoped to that one
# directory (not a blanket *.asm/*.rel) because bios_glue.asm/
# bdos_glue.asm/bdos_jumptable.asm/cpm_crt0.asm there are hand-written
# source, not generated, and *.rel would also hit crasm's own object
# files if it ever produced any. hello.asm/bdos.asm/ccp.asm/
# bios_util.asm/edit.asm are SDCC's own intermediates (compiling any .c
# also leaves one of these behind, same as its .lst/.sym/.noi) - any
# later .c added to that Makefile needs the same per-file treatment
# here, not a wildcard.
modules/cpu/z80/src/main/c/*.rel
modules/cpu/z80/src/main/c/*.ihx
modules/cpu/z80/src/main/c/*.lk
modules/cpu/z80/src/main/c/*.map
modules/cpu/z80/src/main/c/*.noi
modules/cpu/z80/src/main/c/*.sym
modules/cpu/z80/src/main/c/hello.asm
modules/cpu/z80/src/main/c/bdos.asm
modules/cpu/z80/src/main/c/ccp.asm
modules/cpu/z80/src/main/c/bios_util.asm
modules/cpu/z80/src/main/c/edit.asm
